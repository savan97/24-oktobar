_css_classes": "t-lead"}, "elements": []}]}]}, {"id": "1fba17a", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1240, "sizes": []}, "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 64, "column": "64", "row": "64", "isLinked": true}, "flex_gap_mobile": {"unit": "px", "size": 32, "column": "32", "row": "32", "isLinked": true}, "padding": {"unit": "px", "top": "112", "right": "24", "bottom": "112", "left": "24", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "24", "bottom": "80", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "56", "right": "20", "bottom": "56", "left": "20", "isLinked": false}, "html_tag": "section", "css_classes": "t-sec t-about", "flex_direction_tablet": "column", "background_background": "classic", "background_color": "#FAF8F4"}, "elements": [{"id": "226273a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "", "width": {"unit": "%", "size": 40}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "3b4ac7a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Rad", "header_size": "p", "_css_classes": "t-eyebrow"}, "elements": []}, {"id": "2d60eb3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Gasifikacija kao stalno otvoreno gradilište", "header_size": "h2", "_css_classes": "t-h2"}, "elements": []}]}, {"id": "2e2e368", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "", "width": {"unit": "%", "size": 60}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "816a03e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Najveći deo našeg rada vezan je za gasifikaciju Novog Sada i okolnih naselja. Sa investitorom Novi Sad Gas ostvarili smo dugogodišnju saradnju kao glavni izvođač građevinskih radova na dovodnim gasovodima, distributivnim gasnim mrežama i kućnim gasnim priključcima — na teritoriji Novog Sada, Bačkog Petrovca, Bačke Palanke, Beočina, Sremskih Karlovaca, Bukovca i drugih mesta.</p><p>U gradskim uslovima organizovali smo niz zahtevnih gradilišta. U podgrađu Petrovaradinske tvrđave izveli smo celokupnu gasnu mrežu: od obezbeđivanja gradilišta i vađenja starih betonskih kocki, preko iskopa kanala, postavljanja cevi i mašinskog nabijanja peska i zemlje, do zatrpavanja kanala i dovođenja terena u prvobitno stanje.</p><p>Pored gasnih mreža, gradili smo toplovod za investitora „Greping“ iz Novog Sada, vodovodne mreže u Bečeju, Suseku i Čeneju i mreže za odvod atmosferskih voda u Bačkom Petrovcu, Magliću i Gložanu. Od 2009. godine radimo i u Bijeljini (BiH), gde smo gradili distributivnu gasnu mrežu, gasovod visokog pritiska Šepak–Bijeljina i telekomunikacionu mrežu.</p>", "_css_classes": "t-prose"}, "elements": []}]}]}, {"id": "ce19167", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1240, "sizes": []}, "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 64, "column": "64", "row": "64", "isLinked": true}, "flex_gap_mobile": {"unit": "px", "size": 32, "column": "32", "row": "32", "isLinked": true}, "padding": {"unit": "px", "top": "112", "right": "24", "bottom": "112", "left": "24", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "24", "bottom": "80", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "56", "right": "20", "bottom": "56", "left": "20", "isLinked": false}, "html_tag": "section", "css_classes": "t-sec t-chrono", "flex_direction_tablet": "column", "background_background": "classic", "background_color": "#F2EEE6"}, "elements": [{"id": "0877841", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "", "width": {"unit": "%", "size": 40}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "e0361da", "elType": "widget", "widgetType": "heading", "settings": {"title": "Hronologija", "header_size": "p", "_css_classes": "t-eyebrow"}, "elements": []}, {"id": "0970498", "elType": "widget", "widgetType": "heading", "settings": {"title": "Nekoliko tačaka iz referentne liste", "header_size": "h2", "_css_classes": "t-h2"}, "elements": []}]}, {"id": "6c47f09", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "", "width": {"unit": "%", "size": 60}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "5e924c3", "elType": "widget", "widgetType": "html", "settings": {"html": "<ol class=\"t-timeline\"><li><span class=\"t-timeline__y\">1997.</span><span class=\"t-timeline__t\">Osnivanje preduzeća u Novom Sadu.</span></li><li><span class=\"t-timeline__y\">1998.</span><span class=\"t-timeline__t\">Distributivne gasne mreže Gložan, Čardak, Bocke i Petrovaradin — prvi radovi na referentnoj listi.</span></li><li><span class=\"t-timeline__y\">1999–2000.</span><span class=\"t-timeline__t\">Toplovod za stambene objekte u ulicama Danila Kiša i Kornelija Stankovića, za investitora „Greping“.</span></li><li><span class=\"t-timeline__y\">2002–2003.</span><span class=\"t-timeline__t\">Gasovod srednjeg pritiska Rumenka–Kisač i gasna mreža u podgrađu Petrovaradinske tvrđave.</span></li><li><span class=\"t-timeline__y\">2007.</span><span class=\"t-timeline__t\">Gasovod Bačka Topola–Feketić i gasne mreže Feketić, Lovćenac i Mali Iđoš.</span></li><li><span class=\"t-timeline__y\">2009.</span><span class=\"t-timeline__t\">Početak radova na distributivnoj gasnoj mreži Bijeljine (BiH).</span></li><li><span class=\"t-timeline__y\">2017–2018.</span><span class=\"t-timeline__t\">Gasovod visokog pritiska Šepak–Bijeljina sa HD podbušivanjem reka, GMRS Obrovac i Bijeljina.</span></li></ol>", "_css_classes": ""}, "elements": []}]}]}, {"id": "d308630", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1240, "sizes": []}, "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 64, "column": "64", "row": "64", "isLinked": true}, "flex_gap_mobile": {"unit": "px", "size": 32, "column": "32", "row": "32", "isLinked": true}, "padding": {"unit": "px", "top": "112", "right": "24", "bottom": "112", "left": "24", "isLinked": false}, "padding_tablet": {"unit": "px", "top": "80", "right": "24", "bottom": "80", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "56", "right": "20", "bottom": "56", "left": "20", "isLinked": false}, "html_tag": "section", "css_classes": "t-sec t-company", "flex_direction_tablet": "column", "background_background": "classic", "background_color": "#FAF8